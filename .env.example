# Copy to .env. Do not commit .env or real documents.
DEMO_MODE=false
DEMO_WRITE_DB=false
DEMO_REGISTRY_JSON=
DEMO_EVIDENCE_JSON=
DEMO_REPORT_JSON=
CONTRACT_TEMPLATE=
WEB_PORT=8765
# Live mode only; keep the service key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_APPROVED_FIELDS=building_name,unit_name

# Existing readers use this server-side key for uncached PDFs.
OPENAI_API_KEY=

# Optional estimate ceiling; blank means no ceiling. Unknown estimates also stop when set.
AI_COST_LIMIT_JPY=
